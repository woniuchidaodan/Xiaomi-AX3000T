# ========== quickstart 整套（核心，保留） ==========
CONFIG_PACKAGE_quickstart=y
CONFIG_PACKAGE_luci-app-quickstart=y
CONFIG_PACKAGE_luci-i18n-quickstart-zh-cn=y
CONFIG_PACKAGE_luci-app-store=y
CONFIG_PACKAGE_luci-lib-taskd=y
CONFIG_PACKAGE_luci-lib-xterm=y
CONFIG_PACKAGE_taskd=y
CONFIG_PACKAGE_ucode=y
CONFIG_PACKAGE_ucode-mod-lua=y
CONFIG_PACKAGE_ucode-mod-ubus=y
CONFIG_PACKAGE_rpcd-mod-ucode=y

# ========== 调试工具（全部砍掉，省内存） ==========
# CONFIG_PACKAGE_bash=y
# CONFIG_PACKAGE_htop=y
# CONFIG_PACKAGE_nano=y
# CONFIG_PACKAGE_openssh-sftp-server=y

# ========== 网络工具（只保留 zram，curl/wget 砍掉） ==========
CONFIG_PACKAGE_zram-swap=y          # 保留，256MB 内存的救命稻草
# CONFIG_PACKAGE_curl=y
# CONFIG_PACKAGE_wget-ssl=y

# ========== 额外内核模块（只保留真正需要的） ==========
CONFIG_PACKAGE_kmod-lib-zstd=y      # 保留，zram 依赖
CONFIG_PACKAGE_kmod-tcp-bbr=y       # 保留，BBR 拥塞控制对网速有益
# CONFIG_PACKAGE_rkp-ipid=y         # 砍掉，之前也编译不进去
# CONFIG_PACKAGE_kmod-rkp-ipid=y    # 砍掉
# CONFIG_PACKAGE_wpad-basic-mbedtls=y # 移除，避免与 ax3000t.config 中的 wpad-openssl 冲突
CONFIG_PACKAGE_kmod-nft-tproxy=y    # 保留，代理（UA3F）依赖
CONFIG_PACKAGE_kmod-nft-queue=y     # 保留，OAF 依赖

# ========== Luci 额外界面（砍掉 advancedplus 和 syscontrol） ==========
CONFIG_PACKAGE_luci-base=y          # 保留，Luci 核心
CONFIG_PACKAGE_luci-lib-fs=y        # 保留
# CONFIG_PACKAGE_luci-app-advancedplus=y   # 砍掉，非必需的大块头
CONFIG_PACKAGE_luci-app-firewall=y  # 保留，防火墙界面
# CONFIG_PACKAGE_luci-app-syscontrol=y    # 砍掉，功能鸡肋

# ========== 中文翻译（保留全部） ==========
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y
CONFIG_PACKAGE_luci-i18n-opkg-zh-cn=y
CONFIG_PACKAGE_luci-i18n-argon-config-zh-cn=y

# ========== Argon 主题（保留，美观） ==========
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-argon-config=y

# ========== UA3F（核心，保留） ==========
CONFIG_PACKAGE_ua3f=y
CONFIG_PACKAGE_luci-app-ua3f=y

# ========== OpenAppFilter 应用过滤（核心，保留） ==========
CONFIG_PACKAGE_luci-app-oaf=y
CONFIG_PACKAGE_open-app-filter=y
CONFIG_PACKAGE_oaf=y

# ========== 🆕 TurboACC MTK 硬件加速（新增） ==========
CONFIG_PACKAGE_luci-app-turboacc-mtk=y
CONFIG_PACKAGE_luci-i18n-turboacc-mtk-zh-cn=y
CONFIG_PACKAGE_kmod-shortcut-fe-drv=y   # 依赖的内核模块（可选，通常会自动选中）
