# ========== quickstart 整套 ==========
CONFIG_PACKAGE_quickstart=y
CONFIG_PACKAGE_luci-app-quickstart=y
CONFIG_PACKAGE_luci-i18n-quickstart-zh-cn=y
CONFIG_PACKAGE_luci-app-store=y
CONFIG_PACKAGE_luci-lib-taskd=y
CONFIG_PACKAGE_luci-lib-xterm=y
CONFIG_PACKAGE_taskd=y
CONFIG_PACKAGE_ucode=y
CONFIG_PACKAGE_ucode-mod-lua=y
CONFIG_PACKAGE_ucode-mod-ubus=y
CONFIG_PACKAGE_rpcd-mod-ucode=y

# ========== 调试工具 ==========
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_nano=y
CONFIG_PACKAGE_openssh-sftp-server=y

# ========== 网络工具 ==========
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget-ssl=y
CONFIG_PACKAGE_zram-swap=y

# ========== 额外内核模块 ==========
CONFIG_PACKAGE_kmod-lib-zstd=y
CONFIG_PACKAGE_kmod-tcp-bbr=y
CONFIG_PACKAGE_kmod-rkp-ipid=y
CONFIG_PACKAGE_wpad-basic-mbedtls=y

# ========== Luci 额外界面 ==========
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-lib-fs=y
CONFIG_PACKAGE_luci-app-advancedplus=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-syscontrol=y

# ========== 中文翻译 ==========
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y
CONFIG_PACKAGE_luci-i18n-opkg-zh-cn=y
CONFIG_PACKAGE_luci-i18n-argon-config-zh-cn=y   # 补上了

# ========== Argon 主题 ==========
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-argon-config=y

# ========== UA3F ==========
CONFIG_PACKAGE_ua3f=y
CONFIG_PACKAGE_luci-app-ua3f=y
